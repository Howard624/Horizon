{
  "ai": {
    "provider": "gemini",
    "model": "gemini-3.5-flash-lite",
    "api_key_env": "GOOGLE_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 4.0,
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 6.5,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 5.5,
        "topic_dedup": true
      },
      "finance-news": {
        "threshold": 9.0,
        "topic_dedup": true
      }
    }
  },
  "display": {
    "icon_style": "emoji"
  },
  "email": {
    "enabled": false,
    "smtp_server": "smtp.qq.com",
    "smtp_port": 465,
    "imap_server": "imap.qq.com",
    "imap_port": 993,
    "email_address": "",
    "sender_name": "Howard AI Radar",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE"
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "karpathy",
        "enabled": true,
        "category": "official-release",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "openai",
        "repo": "openai-python",
        "enabled": true,
        "category": "official-release",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "openai",
        "repo": "openai-agents-python",
        "enabled": true,
        "category": "agents",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "openai",
        "repo": "codex",
        "enabled": true,
        "category": "ai-coding",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "anthropics",
        "repo": "claude-code",
        "enabled": true,
        "category": "ai-coding",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "google-gemini",
        "repo": "gemini-cli",
        "enabled": true,
        "category": "ai-coding",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "modelcontextprotocol",
        "repo": "python-sdk",
        "enabled": true,
        "category": "agents",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "langchain-ai",
        "repo": "langchain",
        "enabled": true,
        "category": "agents",
        "profile": "tech-news"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 8,
      "min_score": 120,
      "category": "discussion",
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "OpenAI News",
        "url": "https://openai.com/news/rss.xml",
        "enabled": true,
        "category": "official-release",
        "profile": "tech-news",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Google DeepMind",
        "url": "https://deepmind.google/blog/rss.xml",
        "enabled": true,
        "category": "official-release",
        "profile": "tech-news",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Google AI",
        "url": "https://blog.google/technology/ai/rss/",
        "enabled": true,
        "category": "official-release",
        "profile": "tech-news"
      },
      {
        "name": "Hugging Face Blog",
        "url": "https://huggingface.co/blog/feed.xml",
        "enabled": true,
        "category": "model-release",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Latent Space",
        "url": "https://www.latent.space/feed",
        "enabled": true,
        "category": "ai-tools",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "One Useful Thing",
        "url": "https://www.oneusefulthing.org/feed",
        "enabled": true,
        "category": "creator-tools",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "GitHub Trending - Daily",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml",
        "enabled": false,
        "category": "github-trending",
        "profile": "tech-news"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 3,
          "min_score": 80,
          "category": "community",
          "profile": "tech-news"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 3,
          "min_score": 80,
          "category": "community",
          "profile": "tech-news"
        },
        {
          "subreddit": "ArtificialInteligence",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 3,
          "min_score": 60,
          "category": "community",
          "profile": "tech-news"
        }
      ],
      "users": [],
      "fetch_comments": 8
    },
    "twitter": {
      "enabled": false,
      "users": [
        "OpenAI",
        "AnthropicAI",
        "GoogleDeepMind",
        "karpathy",
        "simonw"
      ],
      "fetch_limit": 100,
      "category": "social",
      "fetch_reply_text": false,
      "max_replies_per_tweet": 3,
      "max_tweets_to_expand": 5,
      "reply_min_likes": 10,
      "profile": "tech-news"
    },
    "ossinsight": {
      "enabled": false,
      "period": "past_24_hours",
      "languages": [
        "All",
        "Python",
        "TypeScript"
      ],
      "keywords": [
        "AI",
        "LLM",
        "agent",
        "generative-ai"
      ],
      "min_stars": 50,
      "max_items": 30,
      "category": "github-trending",
      "profile": "tech-news"
    },
    "google_news": {
      "enabled": false,
      "query": "OpenAI OR Anthropic OR Google DeepMind OR AI agent OR AI coding",
      "language": "en",
      "country": "AU",
      "ceid": "AU:en",
      "max_results": 12,
      "category": "ai-news",
      "profile": "tech-news"
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 6,
    "profile_order": [
      "tech-news",
      "tech-blog",
      "finance-news"
    ],
    "category_groups": {
      "official": {
        "name": "官方发布与模型动态",
        "limit": 3,
        "categories": [
          "official-release",
          "model-release",
          "ai-news"
        ]
      },
      "build": {
        "name": "Agent 与 AI 编程",
        "limit": 2,
        "categories": [
          "agents",
          "ai-coding"
        ]
      },
      "tools": {
        "name": "热门工具与创作案例",
        "limit": 2,
        "categories": [
          "ai-tools",
          "creator-tools",
          "github-trending"
        ]
      },
      "community": {
        "name": "社区讨论",
        "limit": 1,
        "categories": [
          "community",
          "discussion",
          "social"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 1
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "text": "#{message_title}\n\n#{summary}"
    },
    "headers": ""
  }
}
